# Copy to .env (gitignored) and fill in. Keep comments on their own lines:
# an inline comment after an empty value is read as the value.
#
# The app watches this file and applies changes within a second, with no
# restart (app/live.py). README.md#quick-start walks through it.

# ============ Connect AI: who the agent signs in as ============
# Your Connect AI login email
CDATA_USERNAME=
# Connect AI > Settings > Access Tokens
# https://docs.cloud.cdata.com/en/Settings/Personal-Access-Tokens
CDATA_PAT=

DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# ============ Model calls: the Connect AI LLM Gateway ============
# A virtual key from Connect AI > Routing > Virtual Keys (it starts cgw_).
# The project's routing rule picks the model that answers.
ANTHROPIC_BASE_URL=https://cloud.cdata.com/gateway/v1
ANTHROPIC_API_KEY=
LLM_MODEL=anthropic:claude-sonnet-5-5
# To call Anthropic directly instead, comment out ANTHROPIC_BASE_URL and put
# an Anthropic API key in ANTHROPIC_API_KEY.

# ============ Read-only MCP tools ============
# Uncomment to drop execute_insert, execute_update and executeProcedure.
# CDATA_MCP_URL=https://mcp.cloud.cdata.com/mcp?ops=get_catalogs,get_schemas,get_tables,get_columns,get_instructions,queryData

# ============ Optional ============
# Bearer token for /chat and /tools. Leave unset on localhost; set it anywhere
# the app is reachable from another machine.
# APP_API_KEY=
# Delete conversations idle this many days (they include query results); 0 keeps them
# CONVERSATION_RETENTION_DAYS=30
# Follow-up question chips after each answer (one extra LLM call); false turns them off
# SUGGEST_FOLLOWUPS=true
# Change these if something else already uses the port
# AGENT_PORT=8000
# DB_PORT=5432
